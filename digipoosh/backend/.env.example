# ============================================
#  دیجی‌پوش — متغیرهای محیطی
#  این فایل را به .env.local کپی کنید و مقادیر واقعی را بگذارید
# ============================================

# از Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# کلید مخفی — هرگز در فرانت‌اند استفاده نشود
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# درصد کمیسیون پلتفرم
COMMISSION_RATE=10

# هزینه ارسال (ریال) — صفر یعنی رایگان
SHIPPING_FEE=0

# دامنه‌هایی که اجازه‌ی fetch دارند (با کاما جدا شوند)
# در تولید حتماً دامنه‌ی واقعی خود را بگذارید
ALLOWED_ORIGINS=*
