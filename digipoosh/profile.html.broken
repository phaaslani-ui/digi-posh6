      <select id="aiOutfitCategory" style="width:100%;padding:10px 14px;border:1.5px solid var(--border);border-radius:10px;font-family:inherit;font-size:14px;background:var(--bg-soft)">
        <option value="پیراهن">👕 پیراهن</option>
