    <div id="aiOutfitUploadArea" style="border:2px dashed var(--border);border-radius:14px;padding:30px;text-align:center;cursor:pointer;transition:all 0.2s;background:var(--bg-soft);margin-bottom:16px">
      <div style="font-size:48px;margin-bottom:8px">📷</div>
