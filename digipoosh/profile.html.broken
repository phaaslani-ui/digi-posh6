<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>داشبورد حساب کاربری | دیجی‌پوش</title>
  <meta name="theme-color" content="#f5f0e8" />
  <link rel="icon" href="./favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="./style-clean.css" />
  <link rel="stylesheet" href="./dp-navbar.css" />
  <link rel="stylesheet" href="./club-toast.css" />
  <link rel="stylesheet" href="./assets/css/dp-cart-drawer.css" />
  <style>
  <link rel="stylesheet" href="./dashboard-v2.css" />
  <link rel="stylesheet" href="./wardrobe-v2.css" />
    .prof-page {
      min-height: 100vh;
      background: radial-gradient(ellipse 1000px 500px at 50% -10%, rgba(212, 175, 55, 0.10) 0%, transparent 70%), var(--bg-soft);
      padding: 24px 0 80px;
    }
    .prof-container { max-width: 1320px; margin: 0 auto; padding: 0 20px; }
    .prof-layout {
      display: grid;
      grid-template-columns: 260px 1fr;
      gap: 20px;
      align-items: flex-start;
    }
    .prof-side {
      background: var(--bg-card);
      border-radius: 18px;
      padding: 16px;
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--border-soft);
      position: sticky;
      top: 90px;
    }
    .prof-user {
      text-align: center;
      padding: 10px 0 14px;
      border-bottom: 1px solid var(--border-soft);
      margin-bottom: 12px;
    }
    .prof-avatar {
      width: 64px; height: 64px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--gold), var(--gold-light));
      color: #1a1a1a;
      display: flex; align-items: center; justify-content: center;
      font-size: 26px; font-weight: 800;
      box-shadow: 0 3px 12px rgba(212, 175, 55, 0.3);
      margin: 0 auto 8px;
    }
    .prof-name { font-size: 14px; font-weight: 700; margin-bottom: 2px; }
    .prof-email-mini { font-size: 10.5px; color: var(--text-soft); }

    .prof-side-group {
      font-size: 9.5px;
      font-weight: 700;
      color: var(--text-soft);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 8px 10px 4px;
    }
    .prof-side-group:first-of-type { padding-top: 0; }
    .prof-side-nav { display: flex; flex-direction: column; gap: 2px; }
    .prof-side-btn {
      display: flex; align-items: center; gap: 9px;
      padding: 8px 10px;
      background: transparent; border: none;
      border-radius: 8px;
      color: var(--text-soft);
      font-size: 12px; font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
      text-align: right;
      width: 100%;
      position: relative;
    }
    .prof-side-btn:hover { background: var(--bg-soft); color: var(--text); }
    .prof-side-btn.is-on {
      background: linear-gradient(135deg, rgba(212, 175, 55, 0.12), rgba(244, 229, 177, 0.05));
      color: var(--gold-dark);
      font-weight: 700;
    }
    .prof-side-btn.is-on::before {
      content: ''; position: absolute; right: 0; top: 50%;
      transform: translateY(-50%);
      width: 3px; height: 60%;
      background: var(--gold);
      border-radius: 0 3px 3px 0;
    }
    .prof-side-btn svg { width: 14px; height: 14px; flex-shrink: 0; }
    .prof-side-divider { height: 1px; background: var(--border-soft); margin: 6px 0; }
    .prof-side-btn--danger { color: #ef4444; }

    .prof-main { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
    .prof-card {
      background: var(--bg-card);
      border-radius: 18px;
      padding: 18px 20px;
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--border-soft);
    }
    .prof-card-head {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
    }
    .prof-card-head h2 { font-size: 14px; font-weight: 800; margin: 0; }
    .prof-card-head p { font-size: 11px; color: var(--text-soft); margin: 0; }
    .prof-card-icon {
      width: 34px; height: 34px;
      background: linear-gradient(135deg, var(--gold), var(--gold-light));
      color: #1a1a1a;
      border-radius: 9px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .prof-card-icon svg { width: 16px; height: 16px; }

    .prof-hero {
      background: linear-gradient(135deg, var(--bg-card) 0%, #fff 100%);
      border-radius: 20px;
      padding: 24px;
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--border-soft);
      position: relative;
      overflow: hidden;
    }
    .prof-hero::before {
      content: '';
      position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, var(--gold), var(--gold-light), var(--gold));
    }
    .prof-hero-greet {
      font-size: 22px;
      font-weight: 800;
      margin: 0 0 4px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .prof-hero-greet .name { color: var(--gold-dark); }
    .prof-hero-sub { font-size: 13px; color: var(--text-soft); margin: 0; }

    .prof-stats-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }
    .prof-stat-card {
      background: var(--bg-card);
      border: 1px solid var(--border-soft);
      border-radius: 16px;
      padding: 18px 14px;
      text-align: center;
    }
    .prof-stat-icon {
      width: 40px; height: 40px;
      border-radius: 10px;
      background: linear-gradient(135deg, var(--gold), var(--gold-light));
      color: #1a1a1a;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 8px;
    }
    .prof-stat-icon svg { width: 18px; height: 18px; }
    .prof-stat-num { font-size: 22px; font-weight: 800; color: var(--text); line-height: 1; margin-bottom: 4px; }
    .prof-stat-lbl { font-size: 11px; color: var(--text-soft); }

    .prof-section { display: none; }
    .prof-section.is-on { display: block; }

    .prof-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 14px; }
    .prof-form-row label { display: block; font-size: 11px; font-weight: 600; color: var(--text-soft); margin-bottom: 4px; }
    .prof-form-row input, .prof-form-row textarea {
      width: 100%; padding: 10px 12px;
      background: var(--bg-soft); border: 1.5px solid var(--border-soft);
      border-radius: 8px; font-size: 13px; font-family: inherit; text-align: right;
    }
    .prof-btn {
      padding: 9px 18px; background: linear-gradient(135deg, var(--gold), var(--gold-light));
      color: #1a1a1a; border: none; border-radius: 9px;
      font-weight: 700; font-size: 12px; cursor: pointer;
      font-family: inherit; display: inline-flex; align-items: center; gap: 5px;
    }
    .prof-btn:hover { transform: translateY(-1px); }
    .prof-btn--ghost { background: transparent; border: 1.5px solid var(--border-soft); color: var(--text); }
    .prof-btn--danger { background: transparent; border: 1.5px solid #ef4444; color: #ef4444; }
    .prof-btn--danger:hover { background: #ef4444; color: #fff; }

    .prof-empty { text-align: center; padding: 30px 20px; color: var(--text-soft); }
    .prof-empty svg { width: 40px; height: 40px; opacity: 0.3; margin-bottom: 10px; }
    .prof-empty p { font-size: 13px; margin: 0; }

    @media (max-width: 968px) {
      .prof-layout { grid-template-columns: 1fr; }
      .prof-side { position: static; }
      .prof-stats-grid { grid-template-columns: 1fr; }
      .prof-form-row { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<a class="dp-skip" href="#main">پرش به محتوای اصلی</a>
<div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>

<!-- منوی استاندارد قبل از main -->
<main id="main" class="prof-page">
  <div class="prof-container">
    <div class="prof-layout">

      <!-- ═══ سایدبار ═══ -->
      <aside class="prof-side">
        <div class="prof-user">
          <div class="prof-avatar" id="profAvatar">ع</div>
          <div class="prof-name" id="profName">کاربر</div>
          <div class="prof-email-mini" id="profEmail">user@mail.com</div>
        </div>

        <div class="prof-side-group">حساب</div>
        <div class="prof-side-nav">
          <button class="prof-side-btn is-on" data-section="dashboard">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
            داشبورد
          </button>
          <button class="prof-side-btn" data-section="info">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-7 8-7s8 3 8 7"/></svg>
            اطلاعات شخصی
          </button>
          <button class="prof-side-btn" data-section="orders">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/></svg>
            سفارش‌ها
          </button>
          <button class="prof-side-btn" data-section="favorites">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.5-9.5-9.5C0 6 4 2 8 4l4 3 4-3c4-2 8 2 5.5 7.5C19 16.5 12 21 12 21z"/></svg>
            علاقه‌مندی‌ها
          </button>
          <button class="prof-side-btn" data-section="security">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 1 1 8 0v4"/></svg>
            امنیت
          </button>
        </div>

        <div class="prof-side-divider"></div>
        <div class="prof-side-group">هوش مصنوعی</div>
        <div class="prof-side-nav">
          <button class="prof-side-btn is-new-feature" data-section="stylist">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3.5 1.5 4 4.5.5-3.5 3 1 4.5L12 13l-3.5 2.5 1-4.5L6 8l4.5-.5z"/></svg>
            استایلیست AI
          </button>
          <button class="prof-side-btn is-new-feature" data-section="match">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
            تطبیق با عکس
          </button>
          <button class="prof-side-btn is-new-feature" data-section="wardrobe">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-6 9 6v11a1 1 0 0 1-1 1h-5v-7H10v7H4a1 1 0 0 1-1-1V9z"/></svg>
            کمد مجازی
          </button>
          <button class="prof-side-btn is-new-feature" data-section="taste" id="profTasteBtn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.5 7H22l-6 4.5 2.5 7L12 16l-6.5 4.5 2.5-7L2 9h7.5z"/></svg>
            پیشنهادهای من
            <span class="prof-side-badge" id="profTasteBadge" style="display:none">!</span>
          </button>
          <button class="prof-side-btn is-new-feature" data-section="personality" id="profPersonalityBtn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-7 8-7s8 3 8 7"/></svg>
            تیپ شخصیتی من
            <span class="prof-side-badge" id="profPersonalityBadge" style="display:none">!</span>
          </button>
          <button class="prof-side-btn is-new-feature" data-section="theme" id="profThemeBtn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a10 10 0 1 1 10-10c0 1.7-1.3 3-3 3h-2.5a2.5 2.5 0 0 0 0 5c1.7 0 3 1.3 3 3a3 3 0 0 1-3 3"/><circle cx="7.5" cy="10.5" r="1"/><circle cx="12" cy="7.5" r="1"/><circle cx="16.5" cy="10.5" r="1"/></svg>
            تم صفحه من
            <span class="prof-side-badge" style="background:linear-gradient(135deg,#ec4899,#8b5cf6)">🎨</span>
          </button>
        </div>

        <div class="prof-side-divider"></div>
        <div class="prof-side-nav">
          <button class="prof-side-btn prof-side-btn--danger" id="signOutBtn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/></svg>
            خروج
          </button>
        </div>
      </aside>

      <!-- ═══ محتوای اصلی ═══ -->
      <div class="prof-main">

        <!-- داشبورد -->
        <div id="sec-dashboard" class="prof-section is-on">
          <div class="prof-hero">
            <h1 class="prof-hero-greet">
              <span>سلام <span class="name" id="profGreetName">کاربر</span> عزیز</span>
              👋
            </h1>
            <p class="prof-hero-sub">به پنل کاربری خودت خوش اومدی.</p>
          </div>

          <div class="prof-stats-grid">
            <div class="prof-stat-card">
              <div class="prof-stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/></svg>
              </div>
              <div class="prof-stat-num" id="statOrders">۰</div>
              <div class="prof-stat-lbl">سفارش</div>
            </div>
            <div class="prof-stat-card">
              <div class="prof-stat-icon" style="background:linear-gradient(135deg, #ec4899, #be185d)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.5-9.5-9.5C0 6 4 2 8 4l4 3 4-3c4-2 8 2 5.5 7.5C19 16.5 12 21 12 21z"/></svg>
              </div>
              <div class="prof-stat-num" id="statFavs">۰</div>
              <div class="prof-stat-lbl">علاقه‌مندی</div>
            </div>
            <div class="prof-stat-card">
              <div class="prof-stat-icon" style="background:linear-gradient(135deg, var(--gold), #ff6b9d)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 13L2 9z"/><path d="M2 9h20"/></svg>
              </div>
              <div class="prof-stat-num" id="statCoins">۰</div>
              <div class="prof-stat-lbl">سکه باشگاه</div>
            </div>
          </div>

          <div class="prof-card" style="background:linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);color:#fff;border:none">
            <div class="prof-card-head">
              <div class="prof-card-icon">🏆</div>
              <div>
                <h2 style="color:#fff">باشگاه مشتریان</h2>
                <p style="color:rgba(255,255,255,0.7)">با هر خرید سکه جمع کن، جایزه بگیر</p>
              </div>
            </div>
            <p style="font-size:13px;color:rgba(255,255,255,0.85);margin:0 0 16px;line-height:1.7">به باشگاه مشتریان دیجی‌پوش بپیوند. با ماموریت‌های روزانه، سکه جمع کن و به سطح بالاتر برس.</p>
            <a href="./club.html" class="prof-btn" style="background:#fff;color:#1a1a1a">🎁 ورود به باشگاه</a>
          </div>
        </div>

        <!-- اطلاعات شخصی -->
        <div id="sec-info" class="prof-section">
          <div class="prof-card">
            <div class="prof-card-head">
              <div class="prof-card-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-7 8-7s8 3 8 7"/></svg>
              </div>
              <div>
                <h2>اطلاعات شخصی</h2>
                <p>ویرایش اطلاعات حساب</p>
              </div>
            </div>
            <form id="profileForm">
              <div class="prof-form-row">
                <div>
                  <label>نام</label>
                  <input type="text" id="profFirstName" required />
                </div>
                <div>
                  <label>نام خانوادگی</label>
                  <input type="text" id="profLastName" />
                </div>
              </div>
              <div class="prof-form-row">
                <div>
                  <label>موبایل</label>
                  <input type="tel" id="profPhone" placeholder="۰۹۱۲۳۴۵۶۷۸۹" maxlength="11" />
                </div>
                <div>
                  <label>شهر</label>
                  <input type="text" id="profCity" placeholder="مثلاً تهران" />
                </div>
              </div>
              <button type="submit" class="prof-btn">💾 ذخیره تغییرات</button>
            </form>
          </div>
        </div>

        <!-- سفارش‌ها -->
        <div id="sec-orders" class="prof-section">
          <div class="prof-card">
            <div class="prof-card-head">
              <div class="prof-card-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/></svg>
              </div>
              <div>
                <h2>سفارش‌های من</h2>
                <p>تاریخچه خریدهای شما</p>
              </div>
            </div>
            <div class="prof-empty">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/></svg>
              <p>هنوز سفارشی نداری</p>
              <a href="./index.html" class="prof-btn" style="margin-top:12px">🛍️ مشاهده محصولات</a>
            </div>
          </div>
        </div>

        <!-- علاقه‌مندی‌ها -->
        <div id="sec-favorites" class="prof-section">
          <div class="prof-card">
            <div class="prof-card-head">
              <div class="prof-card-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.5-9.5-9.5C0 6 4 2 8 4l4 3 4-3c4-2 8 2 5.5 7.5C19 16.5 12 21 12 21z"/></svg>
              </div>
              <div>
                <h2>علاقه‌مندی‌های من</h2>
                <p>محصولات ذخیره‌شده</p>
              </div>
            </div>
            <div class="prof-empty">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.5-9.5-9.5C0 6 4 2 8 4l4 3 4-3c4-2 8 2 5.5 7.5C19 16.5 12 21 12 21z"/></svg>
              <p>لیست علاقه‌مندی‌ها خالیه</p>
              <a href="./index.html" class="prof-btn" style="margin-top:12px">🛍️ کاوش محصولات</a>
            </div>
          </div>
        </div>

        <!-- استایلیست AI -->
        <div id="sec-stylist" class="prof-section">
          <div class="prof-feature-hero">
            <div class="prof-feature-hero-content">
              <div class="prof-feature-hero-icon">✨</div>
              <div class="prof-feature-hero-text">
                <h2>استایلیست AI</h2>
                <p>از بین لباس‌های کمدت، ست‌های هماهنگ پیشنهاد بگیر</p>
              </div>
            </div>
          </div>

          <div class="prof-stats-mini">
            <div class="prof-stat-mini-card">
              <span class="prof-stat-mini-icon">👔</span>
              <div class="prof-stat-mini-num" id="stylistItemCount">۰</div>
              <div class="prof-stat-mini-lbl">آیتم کمد</div>
            </div>
            <div class="prof-stat-mini-card">
              <span class="prof-stat-mini-icon">🎨</span>
              <div class="prof-stat-mini-num" id="stylistOutfitCount">۰</div>
              <div class="prof-stat-mini-lbl">ست ذخیره‌شده</div>
            </div>
            <div class="prof-stat-mini-card">
              <span class="prof-stat-mini-icon">💎</span>
              <div class="prof-stat-mini-num" id="stylistCoverage">۰٪</div>
              <div class="prof-stat-mini-lbl">پوشش فصلی</div>
            </div>
            <div class="prof-stat-mini-card">
              <span class="prof-stat-mini-icon">✨</span>
              <div class="prof-stat-mini-num" id="stylistAvgMatch">۰</div>
              <div class="prof-stat-mini-lbl">میانگین تطبیق</div>
            </div>
          </div>

          <div class="prof-card">
            <div class="prof-card-head">
              <div class="prof-card-icon">🎨</div>
              <div>
                <h2>ست‌های پیشنهادی</h2>
                <p>هوشمندانه از بین آیتم‌های کمدت</p>
              </div>
            </div>
            <div id="stylistList"></div>
          </div>
        </div>

        <!-- تحلیل با عکس -->
        <div id="sec-match" class="prof-section" data-profile-root>
          <div class="prof-feature-hero">
            <div class="prof-feature-hero-content">
              <div class="prof-feature-hero-icon">📸</div>
              <div class="prof-feature-hero-text">
                <h2>تحلیل با عکس</h2>
                <p>عکست رو آپلود کن، AI واقعی رنگ پوست، فرم بدن و چهره رو تحلیل می‌کنه و محصولات <strong>واقعی</strong> فروشگاه رو پیشنهاد میده</p>
              </div>
            </div>
          </div>

          <div class="prof-card">
            <div class="prof-card-head">
              <div class="prof-card-icon">📷</div>
              <div>
                <h2>آپلود عکس</h2>
                <p>برای تحلیل کامل با AI</p>
              </div>
            </div>

            <label class="prof-upload-box" id="photoUploadBox">
              <div class="prof-upload-icon">📸</div>
              <div class="prof-upload-text">عکست رو اینجا بنداز یا کلیک کن</div>
              <div class="prof-upload-hint">JPG یا PNG - حداکثر ۵ مگابایت - بهتره روبه‌رو و با نور کافی</div>
              <input type="file" accept="image/*" class="prof-upload-input" id="photoInput" />
            </label>

            <div id="photoResult" style="display:none; margin-top: 16px;">
              <div class="prof-photo-preview-wrap">
                <img id="photoPreview" alt="" />
                <button class="prof-btn prof-btn--ghost prof-btn--sm" id="photoResetBtn" style="margin-top:8px">🔄 عکس دیگه</button>
              </div>
              <div id="photoAnalysisGrid" class="prof-photo-analysis"></div>
            </div>
          </div>

          <!-- 🆕 محصولات پیشنهادی بر اساس تحلیل عکس -->
          <div class="prof-card" id="photoMatchProductsCard" style="display:none">
            <div class="prof-card-head">
              <div class="prof-card-icon">✨</div>
              <div>
                <h2>پیشنهادهای متناسب با شما</h2>
                <p>بر اساس رنگ پوست، چهره و فرم بدنت</p>
              </div>
            </div>
            <div class="prof-photo-match-grid" id="photoMatchGrid"></div>
          </div>

          <!-- 🆕 Virtual Try-On -->
          <div class="prof-card" id="virtualTryOnCard" style="display:none">
            <div class="prof-card-head">
              <div class="prof-card-icon">🕶️</div>
              <div>
                <h2>پرو مجازی (Virtual Try-On)</h2>
                <p>محصولات رو روی عکست امتحان کن</p>
              </div>
            </div>
            <div class="prof-tryon-tabs">
              <button class="prof-tryon-tab is-on" data-tryon="glasses">🕶️ عینک</button>
              <button class="prof-tryon-tab" data-tryon="necklace">📿 گردنبند</button>
              <button class="prof-tryon-tab" data-tryon="earring">💎 گوشواره</button>
            </div>
            <div class="prof-tryon-stage" id="tryonStage">
              <div class="prof-tryon-canvas" id="tryonCanvas">
                <img id="tryonBaseImage" alt="" />
                <canvas id="tryonOverlay"></canvas>
              </div>
              <div class="prof-tryon-products" id="tryonProducts"></div>
            </div>
          </div>
        </div>

        <!-- کمد مجازی -->
        <div id="sec-wardrobe" class="prof-section">
          <div class="prof-feature-hero">
            <div class="prof-feature-hero-content">
              <div class="prof-feature-hero-icon">👔</div>
              <div class="prof-feature-hero-text">
                <h2>کمد مجازی</h2>
                <p>تمام لباس‌هات رو اینجا ببین، دسته‌بندی و استفاده کن</p>
              </div>
            </div>
          </div>

          <div class="prof-stats-mini">
            <div class="prof-stat-mini-card">
              <span class="prof-stat-mini-icon">👕</span>
              <div class="prof-stat-mini-num" id="wardrobeTotal">۰</div>
              <div class="prof-stat-mini-lbl">کل آیتم</div>
            </div>
            <div class="prof-stat-mini-card">
              <span class="prof-stat-mini-icon">👗</span>
              <div class="prof-stat-mini-num" id="wardrobeTops">۰</div>
              <div class="prof-stat-mini-lbl">تاپ</div>
            </div>
            <div class="prof-stat-mini-card">
              <span class="prof-stat-mini-icon">👖</span>
              <div class="prof-stat-mini-num" id="wardrobeBottoms">۰</div>
              <div class="prof-stat-mini-lbl">شلوار</div>
            </div>
            <div class="prof-stat-mini-card">
              <span class="prof-stat-mini-icon">💎</span>
              <div class="prof-stat-mini-num" id="wardrobeValue">۰</div>
              <div class="prof-stat-mini-lbl">ارزش کل</div>
            </div>
          </div>

          <div class="prof-card">
            <div class="prof-card-head">
              <div class="prof-card-icon">👔</div>
              <div>
                <h2>آیتم‌های کمد</h2>
                <p>دسته‌بندی بر اساس نوع</p>
              </div>
              <div style="margin-right:auto;display:flex;gap:6px;flex-wrap:wrap">
                <button class="prof-btn prof-btn--gold prof-btn--sm" id="addManualWardrobeBtn" style="background:linear-gradient(135deg,#d4af37,#f4d97c)">➕ افزودن دستی</button>
                <button class="prof-btn prof-btn--ghost prof-btn--sm" id="syncWardrobeBtn">🔄 همگام‌سازی</button>
                <button class="prof-btn prof-btn--ghost prof-btn--sm" id="quickFillWardrobeBtn">⚡ نمونه‌های آماده</button>
              </div>
            </div>

            <div class="prof-wardrobe-tabs" id="wardrobeTabs">
              <button class="prof-wardrobe-tab is-on" data-cat="all">همه <span class="count" id="countAll">۰</span></button>
              <button class="prof-wardrobe-tab" data-cat="top">تاپ <span class="count" id="countTop">۰</span></button>
              <button class="prof-wardrobe-tab" data-cat="bottom">شلوار <span class="count" id="countBottom">۰</span></button>
              <button class="prof-wardrobe-tab" data-cat="shoe">کفش <span class="count" id="countShoe">۰</span></button>
              <button class="prof-wardrobe-tab" data-cat="accessory">اکسسوری <span class="count" id="countAccessory">۰</span></button>
            </div>

            <div class="prof-wardrobe-grid" id="wardrobeGrid"></div>
          </div>
        </div>

        <!-- 🆕 v18.2 — AI ست‌ساز با کمد کاربر -->
        <div id="sec-ai-outfit" class="prof-section" style="margin-top:24px">
          <div class="prof-feature-hero" style="background:linear-gradient(135deg, rgba(212,175,55,0.2), rgba(212,175,55,0.05))">
            <div class="prof-feature-hero-content">
              <div class="prof-feature-hero-icon">🤖</div>
              <div class="prof-feature-hero-text">
                <h2>AI ست‌ساز با کمد شما</h2>
                <p>عکس لباس‌هات رو آپلود کن، AI رنگ و استایل رو می‌فهمه و با لباس‌های واقعی‌ات ست می‌سازه</p>
              </div>
            </div>
          </div>

          <!-- 🆕 v19.0 — انتخاب‌گر هوشمند -->
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:16px 0;padding:12px;background:var(--bg-soft);border-radius:12px">
            <div>
              <label style="display:block;font-size:12px;color:var(--text-soft);margin-bottom:4px;font-weight:700">موقعیت:</label>
              <select id="aiOutfitOccasionSelect" style="width:100%;padding:8px;border:1.5px solid var(--border);border-radius:8px;font-family:inherit;background:var(--bg-card)">
                <option value="روزمره">☀️ روزمره</option>
                <option value="اداری">💼 اداری</option>
                <option value="رسمی">👔 رسمی</option>
                <option value="مجلسی">✨ مجلسی</option>
                <option value="ورزشی">🏃 ورزشی</option>
                <option value="عروسی">💍 عروسی</option>
              </select>
            </div>
            <div>
              <label style="display:block;font-size:12px;color:var(--text-soft);margin-bottom:4px;font-weight:700">فصل:</label>
              <select id="aiOutfitSeasonSelect" style="width:100%;padding:8px;border:1.5px solid var(--border);border-radius:8px;font-family:inherit;background:var(--bg-card)">
                <option value="چهار فصل">🌍 چهار فصل</option>
                <option value="بهار">🌸 بهار</option>
                <option value="تابستان">☀️ تابستان</option>
                <option value="پاییز">🍂 پاییز</option>
                <option value="زمستان">❄️ زمستان</option>
              </select>
            </div>
          </div>

          <!-- دکمه‌های اصلی -->
          <div style="display:flex;gap:10px;flex-wrap:wrap;margin:16px 0">
            <button id="aiOutfitAddBtn" class="prof-btn prof-btn--gold">
              ➕ افزودن لباس به کمد
            </button>
            <button id="aiOutfitGenerateBtn" class="prof-btn prof-btn--gold" style="background:linear-gradient(135deg,#d4af37,#f4d97c)">
              ✨ ساخت ست هوشمند
            </button>
            <span style="margin-right:auto;color:var(--text-soft);font-size:13px;align-self:center" id="aiOutfitStatus">
              کمد شما: <strong id="aiOutfitCount">۰</strong> آیتم
            </span>
          </div>

          <!-- نتایج ست‌ها -->
          <div id="aiOutfitResults" style="display:none">
            <h3 style="margin:20px 0 12px;font-size:16px;color:var(--gold)">✨ ست‌های پیشنهادی برای شما</h3>
            <div id="aiOutfitList"></div>
          </div>

          <!-- پیام خالی -->
          <div id="aiOutfitEmpty" style="display:none;text-align:center;padding:40px 20px;background:var(--bg-soft);border-radius:14px;margin-top:16px">
            <div style="font-size:48px;margin-bottom:12px;opacity:0.5">🤖</div>
            <p style="margin:0;color:var(--text-soft);font-size:14px">برای ساخت ست، ابتدا حداقل یک تاپ و یک شلوار/دامن به کمد اضافه کنید</p>
          </div>
        </div>

        <!-- پیشنهادهای من (سلیقه + AI) -->
        <div id="sec-taste" class="prof-section">
          <!-- اگه سلیقه ثبت نشده: فرم -->
          <div id="tasteFormWrap" style="display:none">
            <div class="prof-feature-hero" style="background:linear-gradient(135deg, rgba(212,175,55,0.18), rgba(212,175,55,0.06))">
              <div class="prof-feature-hero-content">
                <div class="prof-feature-hero-icon">✨</div>
                <div class="prof-feature-hero-text">
                  <h2>سلیقه‌ات رو ثبت کن</h2>
                  <p>با چند کلیک، بهترین محصولات واقعی فروشندگان رو بهت معرفی می‌کنیم</p>
                </div>
              </div>
            </div>

            <div class="prof-card" id="tasteFormCard">
              <!-- فرم ۵ مرحله‌ای توسط dp-taste-profile.js رندر می‌شود -->
            </div>
          </div>

          <!-- اگه سلیقه ثبت شده: پیشنهادها -->
          <div id="tasteResultWrap" style="display:none">
            <div class="prof-feature-hero" style="background:linear-gradient(135deg, rgba(16,185,129,0.15), rgba(212,175,55,0.08))">
              <div class="prof-feature-hero-content">
                <div class="prof-feature-hero-icon">🎯</div>
                <div class="prof-feature-hero-text">
                  <h2>پیشنهادهای ویژه برای تو</h2>
                  <p id="tasteResultSubtitle">بر اساس سلیقه‌ات، از بین محصولات واقعی فروشندگان</p>
                </div>
                <button class="prof-btn prof-btn--ghost prof-btn--sm" id="tasteEditBtn" style="margin-right:auto">✏️ ویرایش سلیقه</button>
              </div>
            </div>

            <div class="prof-stats-mini">
              <div class="prof-stat-mini-card">
                <span class="prof-stat-mini-icon">🎯</span>
                <div class="prof-stat-mini-num" id="tasteMatchCount">۰</div>
                <div class="prof-stat-mini-lbl">تطابق بالای ۶۵٪</div>
              </div>
              <div class="prof-stat-mini-card">
                <span class="prof-stat-mini-icon">🏪</span>
                <div class="prof-stat-mini-num" id="tasteSellerCount">۰</div>
                <div class="prof-stat-mini-lbl">فروشنده</div>
              </div>
              <div class="prof-stat-mini-card">
                <span class="prof-stat-mini-icon">💎</span>
                <div class="prof-stat-mini-num" id="tasteTopMatch">۰٪</div>
                <div class="prof-stat-mini-lbl">بالاترین تطابق</div>
              </div>
              <div class="prof-stat-mini-card">
                <span class="prof-stat-mini-icon">🧬</span>
                <div class="prof-stat-mini-num" id="tasteType" style="font-size:14px">—</div>
                <div class="prof-stat-mini-lbl">DNA سلیقه</div>
              </div>
            </div>

            <div class="prof-card">
              <div class="prof-card-head">
                <div class="prof-card-icon">✨</div>
                <div>
                  <h2>محصولات پیشنهادی</h2>
                  <p>حداقل ۶۵٪ تطابق با سلیقه شما</p>
                </div>
                <button class="prof-btn prof-btn--ghost prof-btn--sm" id="tasteRefreshBtn" style="margin-right:auto">🔄 به‌روزرسانی</button>
              </div>
              <div class="prof-taste-grid" id="tasteGrid"></div>
            </div>
          </div>
        </div>

        <!-- تیپ شخصیتی من -->
        <div id="sec-personality" class="prof-section">
          <div class="prof-feature-hero" style="background:linear-gradient(135deg, rgba(139,92,246,0.18), rgba(236,72,153,0.06))">
            <div class="prof-feature-hero-content">
              <div class="prof-feature-hero-icon">🪞</div>
              <div class="prof-feature-hero-text">
                <h2>تیپ شخصیتی من</h2>
                <p>AI بر اساس سلیقه و رفتارت، یه تصویر واقع‌بینانه ازت می‌ده</p>
              </div>
            </div>
          </div>

          <!-- کارت اصلی شخصیت -->
          <div class="prof-card" id="personalityMainCard">
            <!-- توسط JS رندر میشه -->
          </div>

          <!-- ۳ آرکی‌تایپ برتر -->
          <div class="prof-card">
            <div class="prof-card-head">
              <div class="prof-card-icon">🎭</div>
              <div>
                <h2>آرکی‌تایپ‌های شخصیتی</h2>
                <p>بر اساس Big Five و رفتار واقعی</p>
              </div>
            </div>
            <div id="archetypesGrid" class="prof-archetypes-grid"></div>
          </div>

          <!-- نمودار Big Five -->
          <div class="prof-card">
            <div class="prof-card-head">
              <div class="prof-card-icon">🧠</div>
              <div>
                <h2>پروفایل شخصیتی (Big Five)</h2>
                <p>پنج بُعد اصلی شخصیت</p>
              </div>
            </div>
            <div id="bigFiveChart" class="prof-bigfive-chart"></div>
          </div>

          <!-- آمار رفتاری -->
          <div class="prof-card">
            <div class="prof-card-head">
              <div class="prof-card-icon">📊</div>
              <div>
                <h2>تحلیل رفتاری</h2>
                <p>از ۹۰ روز استفاده‌ات</p>
              </div>
              <button class="prof-btn prof-btn--ghost prof-btn--sm" id="refreshPersonalityBtn" style="margin-right:auto">🔄 به‌روزرسانی</button>
            </div>
            <div id="behaviorStats" class="prof-behavior-stats"></div>
          </div>

          <!-- بینش‌ها -->
          <div class="prof-card" id="insightsCard">
            <div class="prof-card-head">
              <div class="prof-card-icon">💡</div>
              <div>
                <h2>بینش‌های AI درباره تو</h2>
                <p>تحلیل صادقانه بر اساس رفتار واقعی</p>
              </div>
            </div>
            <div id="personalityInsights"></div>
          </div>
        </div>

        <!-- تم صفحه من -->
        <div id="sec-theme" class="prof-section" data-profile-root>
          <div class="prof-feature-hero">
            <div class="prof-feature-hero-content">
              <div class="prof-feature-hero-icon">🎨</div>
              <div class="prof-feature-hero-text">
                <h2>تم صفحه من</h2>
                <p>رنگ صفحه پروفایلت رو شخصی‌سازی کن. فقط صفحه خودت عوض می‌شه</p>
              </div>
            </div>
          </div>
          <div id="themeBuilderContainer"></div>
        </div>

        <!-- امنیت -->
        <div id="sec-security" class="prof-section">
          <div class="prof-card">
            <div class="prof-card-head">
              <div class="prof-card-icon" style="background:linear-gradient(135deg, #ef4444, #f59e0b)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 1 1 8 0v4"/></svg>
              </div>
              <div>
                <h2>امنیت حساب</h2>
                <p>محافظت از حساب شما</p>
              </div>
            </div>

            <form id="passwordForm" style="max-width:400px">
              <div style="margin-bottom:12px">
                <label style="display:block;font-size:11px;font-weight:600;color:var(--text-soft);margin-bottom:4px">رمز عبور فعلی</label>
                <input type="password" id="oldPassword" required minlength="6" style="width:100%;padding:10px 12px;background:var(--bg-soft);border:1.5px solid var(--border-soft);border-radius:8px;font-size:13px;font-family:inherit" />
              </div>
              <div style="margin-bottom:12px">
                <label style="display:block;font-size:11px;font-weight:600;color:var(--text-soft);margin-bottom:4px">رمز جدید</label>
                <input type="password" id="newPassword" required minlength="6" style="width:100%;padding:10px 12px;background:var(--bg-soft);border:1.5px solid var(--border-soft);border-radius:8px;font-size:13px;font-family:inherit" />
              </div>
              <div style="margin-bottom:12px">
                <label style="display:block;font-size:11px;font-weight:600;color:var(--text-soft);margin-bottom:4px">تکرار رمز جدید</label>
                <input type="password" id="confirmPassword" required minlength="6" style="width:100%;padding:10px 12px;background:var(--bg-soft);border:1.5px solid var(--border-soft);border-radius:8px;font-size:13px;font-family:inherit" />
              </div>
              <button type="submit" class="prof-btn">🔒 تغییر رمز عبور</button>
            </form>
          </div>
        </div>

      </div>
    </div>
  </div>
</main>

<footer class="footer">
  <div class="footer__bottom">
    <span>© ۱۴۰۵ دیجی‌پوش — تمامی حقوق محفوظ است.</span>
  </div>
</footer>

<div class="toast" id="toast">
  <span class="toast__icon">✨</span>
  <span class="toast__text" id="toastText">عملیات موفق</span>
</div>

<script src="./dp-auth.js"></script>
<script src="./dp-memory.js"></script>
<!-- 🆕 v18.2 — Modal افزودن لباس با آپلود عکس -->
<!-- 🆕 v19.1 — Modal افزودن لباس به کمد -->
<div id="manualWardrobeModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:99999;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(4px)">
  <div style="background:var(--bg-card);border-radius:20px;padding:24px;max-width:480px;width:100%;max-height:92vh;overflow-y:auto;box-shadow:0 30px 80px rgba(0,0,0,0.4)">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
      <h3 style="margin:0;font-size:18px;color:var(--gold)">👕 افزودن لباس به کمد</h3>
      <button id="manualWardrobeClose" style="background:none;border:none;font-size:24px;cursor:pointer;color:var(--text-soft)">✕</button>
    </div>

    <div style="margin-bottom:12px">
      <label style="display:block;font-size:13px;font-weight:700;margin-bottom:6px">نام لباس *</label>
      <input type="text" id="mwName" placeholder="مثلاً: پیراهن سفید دکمه‌دار"
        style="width:100%;padding:10px 14px;border:1.5px solid var(--border);border-radius:10px;font-family:inherit;font-size:14px;background:var(--bg-soft)"/>
    </div>

    <div style="margin-bottom:12px">
      <label style="display:block;font-size:13px;font-weight:700;margin-bottom:6px">دسته *</label>
      <select id="mwCategory" style="width:100%;padding:10px 14px;border:1.5px solid var(--border);border-radius:10px;font-family:inherit;font-size:14px;background:var(--bg-soft)">
        <option value="پیراهن">👕 پیراهن</option>
        <option value="تیشرت">👕 تیشرت</option>
        <option value="بلوز">👚 بلوز</option>
        <option value="کت">🧥 کت</option>
        <option value="پالتو">🧥 پالتو</option>
        <option value="شلوار">👖 شلوار</option>
        <option value="دامن">👗 دامن</option>
        <option value="کفش">👟 کفش</option>
        <option value="اکسسوری">💎 اکسسوری</option>
      </select>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px">
      <div>
        <label style="display:block;font-size:13px;font-weight:700;margin-bottom:6px">رنگ</label>
        <input type="text" id="mwColor" placeholder="مثلاً: آبی"
          style="width:100%;padding:10px 14px;border:1.5px solid var(--border);border-radius:10px;font-family:inherit;font-size:14px;background:var(--bg-soft)"/>
      </div>
      <div>
        <label style="display:block;font-size:13px;font-weight:700;margin-bottom:6px">سایز</label>
        <input type="text" id="mwSize" placeholder="مثلاً: M"
          style="width:100%;padding:10px 14px;border:1.5px solid var(--border);border-radius:10px;font-family:inherit;font-size:14px;background:var(--bg-soft)"/>
      </div>
    </div>

    <div style="margin-bottom:12px">
      <label style="display:block;font-size:13px;font-weight:700;margin-bottom:6px">قیمت (تومان)</label>
      <input type="number" id="mwPrice" placeholder="مثلاً: 850000"
        style="width:100%;padding:10px 14px;border:1.5px solid var(--border);border-radius:10px;font-family:inherit;font-size:14px;background:var(--bg-soft)"/>
    </div>

    <div style="margin-bottom:16px">
      <label style="display:block;font-size:13px;font-weight:700;margin-bottom:6px">تگ‌ها (با کاما جدا کنید)</label>
      <input type="text" id="mwTags" placeholder="مثلاً: کلاسیک, رسمی, اداری"
        style="width:100%;padding:10px 14px;border:1.5px solid var(--border);border-radius:10px;font-family:inherit;font-size:14px;background:var(--bg-soft)"/>
    </div>

    <div style="display:flex;gap:8px;justify-content:flex-end">
      <button id="mwCancel" style="padding:11px 22px;background:var(--bg-soft);border:1px solid var(--border);border-radius:10px;cursor:pointer;font-family:inherit;font-weight:700">انصراف</button>
      <button id="mwSave" style="padding:11px 22px;background:linear-gradient(135deg,#d4af37,#f4d97c);color:#1a1a1a;border:none;border-radius:10px;cursor:pointer;font-family:inherit;font-weight:800">✅ افزودن به کمد</button>
    </div>
  </div>
</div>


<div id="aiOutfitModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:99999;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(4px)">
  <div style="background:var(--bg-card);border-radius:20px;padding:24px;max-width:500px;width:100%;max-height:92vh;overflow-y:auto;box-shadow:0 30px 80px rgba(0,0,0,0.4)">
