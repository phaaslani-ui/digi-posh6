{
  "version": 2,
  "builds": [
    {
      "src": "src/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/index.js"
    }
  ],
  "env": {
    "GEMINI_API_KEY": "@gemini-api-key",
    "OPENROUTER_API_KEY": "@openrouter-api-key",
    "GROQ_API_KEY": "@groq-api-key"
  }
}
